<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>CineMan Cinema Management System</display-name>

    <welcome-file-list>
        <welcome-file>LoginUI1.jsp</welcome-file>
    </welcome-file-list>

    <!-- AccountServlet1 -->
    <servlet>
        <servlet-name>AccountServlet1</servlet-name>
        <servlet-class>com.cineman.servlet.AccountServlet1</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountServlet1</servlet-name>
        <url-pattern>/account</url-pattern>
    </servlet-mapping>

    <!-- MovieServlet1 -->
    <servlet>
        <servlet-name>MovieServlet1</servlet-name>
        <servlet-class>com.cineman.servlet.MovieServlet1</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovieServlet1</servlet-name>
        <url-pattern>/movie</url-pattern>
    </servlet-mapping>

    <!-- ScreeningServlet1 -->
    <servlet>
        <servlet-name>ScreeningServlet1</servlet-name>
        <servlet-class>com.cineman.servlet.ScreeningServlet1</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ScreeningServlet1</servlet-name>
        <url-pattern>/screening</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
